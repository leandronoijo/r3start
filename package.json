{
  "name": "starter-project",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@starter/api",
    "dev:web": "npm run dev --workspace=@starter/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build --workspace=@starter/shared && npm run typecheck --workspace=@starter/api && npm run typecheck --workspace=@starter/web",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace=@starter/shared && npm run build --workspace=@starter/api && npm run build --workspace=@starter/web",
    "db:generate": "npm run db:generate --workspace=@starter/api",
    "db:migrate": "npm run db:migrate --workspace=@starter/api",
    "db:seed": "npm run db:seed --workspace=@starter/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.24.0"
  }
}
